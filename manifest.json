{
  "manifest_version": 3,
  "name": "Rekos 12fps",
  "version": "0.1",
  "description": "Tools For High Quality Uploads on Tiktok",
  "permissions": [
    "downloads",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "https://county-back-end-blocked.vercel.app/api/access*",
    "https://Rekos-announcement-v3.vercel.app/announcement.json*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rekos 12fps",
    "default_icon": {
      "16": "icons/rekos_logo_16.png",
      "32": "icons/rekos_logo_32.png",
      "48": "icons/rekos_logo_48.png",
      "128": "icons/rekos_logo_128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.tiktok.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": ["popup.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.tiktok.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": ["dynamic_island.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://www.tiktok.com/tiktokstudio/upload*",
        "*://www.tiktok.com/upload*",
        "*://www.tiktok.com/creator-center*",
        "*://*.tiktok.com/upload*",
        "*://*.tiktok.com/creator-center*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.tiktok.com/tiktokstudio/upload*",
        "*://www.tiktok.com/upload*",
        "*://www.tiktok.com/creator-center*",
        "*://*.tiktok.com/upload*",
        "*://*.tiktok.com/creator-center*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dynamic_island.js", "icons/*"],
      "matches": ["*://*.tiktok.com/*"]
    }
  ],
  "icons": {
    "16": "icons/rekos_logo_16.png",
    "32": "icons/rekos_logo_32.png",
    "48": "icons/rekos_logo_48.png",
    "128": "icons/rekos_logo_128.png"
  }
}
